{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (Debug)",
            "type": "shell",
            "command": "dotnet build RT950toCSV.sln --configuration Debug",
            "group": "build",
            "presentation": { "reveal": "always", "panel": "shared" },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build (Release)",
            "type": "shell",
            "command": "dotnet build RT950toCSV.sln --configuration Release",
            "group": "build",
            "presentation": { "reveal": "always", "panel": "shared" },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Run",
            "type": "shell",
            "command": "dotnet run --project src/RT950toCSV.App/RT950toCSV.App.csproj",
            "group": "test",
            "presentation": { "reveal": "always", "panel": "shared" },
            "problemMatcher": []
        },
        {
            "label": "Publish (win-x64)",
            "type": "shell",
            "command": "dotnet publish src/RT950toCSV.App/RT950toCSV.App.csproj --configuration Release --runtime win-x64 --self-contained true -p:PublishSingleFile=true -o publish/",
            "group": "build",
            "presentation": { "reveal": "always", "panel": "shared" },
            "problemMatcher": "$msCompile"
        }
    ]
}
